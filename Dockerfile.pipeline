# Self-contained, Docker-only build pipeline for the OpenSCAD WASM port.
#
# It reproduces everything the Makefile drives on the host (fetching pinned
# sources, building the emscripten sysroot dependencies, cross-compiling
# OpenSCAD, bundling the JS runtime, vendoring three.js for the example page)
# so the only host requirement is `docker` itself - no make, deno, node or npm
# on the host machine.
#
#   ./build.sh                # full build + extract artifacts into ./dist
#   ./serve.sh                # serve the example page at http://localhost:8080
#
# Or directly:
#
#   docker build -f Dockerfile.pipeline --target example -t openscad-wasm:local .
#
# Intermediate targets (libs, builder, wasm-base, openscad, runtime) can be
# built individually for debugging, e.g. --target openscad.

ARG EMSCRIPTEN_VERSION=6.0.5
# Overridden by build.sh with the arm64 variant on arm64 hosts.
ARG EMSCRIPTEN_SDK_TAG=emscripten/emsdk:6.0.5-arm64
# Max parallel compile jobs per stage. Left unlimited (-j$(nproc)) the build
# saturates every core for a long time and can overheat a laptop; build.sh
# also builds the stages one by one so BuildKit does not run several
# compilations concurrently. Lower it further with JOBS=2 ./build.sh.
ARG JOBS=4

###############################################################################
# Stage: libs
#
# Fetch every source tree / tarball. Refs and URLs are pinned exactly like the
# Makefile, so both build paths produce the same sources.
###############################################################################
FROM debian:bookworm-slim AS libs

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        wget \
        xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Shallow-clone helper. Fetches a ref (tag or commit SHA) instead of using
# `git clone --branch`, because the latter cannot check out a SHA.
COPY <<'EOF' /usr/local/bin/clone
#!/bin/sh
# clone <dir> <repo> <ref> [recursive]
set -e
mkdir -p "$1"
git -C "$1" init -q
git -C "$1" remote add origin "$2"
git -C "$1" fetch --depth 1 origin "$3"
git -C "$1" checkout --detach FETCH_HEAD
if [ "$4" = "recursive" ]; then
    git -C "$1" submodule update --init --recursive --depth 1
fi
EOF
RUN chmod +x /usr/local/bin/clone

# Download helper for a flaky network: connects intermittently time out, so
# every file is fetched from a list of mirrors, each retried several times
# with a hard timeout so nothing hangs forever.
COPY <<'EOF' /usr/local/bin/fetch
#!/bin/sh
# fetch <output-file> <url>...
set -e
out="$1"; shift
attempt=0
while [ "$attempt" -lt 5 ]; do
    attempt=$((attempt + 1))
    for url in "$@"; do
        if wget --timeout=30 --tries=1 --retry-connrefused -q -O "$out" "$url"; then
            exit 0
        fi
        rm -f "$out"
        echo "fetch: failed (attempt $attempt): $url" >&2
    done
    sleep 2
done
echo "fetch: giving up on $*" >&2
exit 4
EOF
RUN chmod +x /usr/local/bin/fetch

WORKDIR /home/libs

# Release tags (values mirror the Makefile).
ARG CAIRO_REF=1.18.4
ARG CGAL_REF=v6.0.3
ARG DOUBLECONVERSION_REF=v3.4.0
ARG EIGEN_REF=5.0.1
ARG FONTCONFIG_REF=2.18.2
ARG FREETYPE_REF=VER-2-14-3
ARG HARFBUZZ_REF=14.3.0
ARG LIB3MF_REF=v2.3.2
ARG LIBEXPAT_REF=R_2_8_2
ARG LIBFFI_REF=v3.7.1
ARG LIBXML2_REF=v2.15.3
ARG LIBZIP_REF=v1.11.4
ARG ZLIB_REF=v1.3.2

# These upstreams publish no usable release tag, so they stay pinned to the
# commit SHAs used by the Makefile.
ARG GLIB_REF=3994b22020c9f61121ebbc902f19cfe906dd745b
ARG LIBERATION_REF=ef7161f03e305982b0b247e9a0b7cc472376dd83
ARG MCAD_REF=bd0a7ba3f042bfbced5ca1894b236cea08904e26
ARG OPENSCAD_REF=04834adb1ba3c9a6e4160747c91cbadbce9c37b3

# Tarball-pinned dependencies.
ARG BOOST_URL=https://github.com/boostorg/boost/releases/download/boost-1.87.0/boost-1.87.0-b2-nodocs.tar.xz
# Same tarballs the Makefile pins; fetched from several mirrors because
# gmplib.org / ftp.gnu.org are not reliably reachable from the build network.
ARG GMP_MIRRORS="https://mirrors.kernel.org/gnu/gmp/gmp-6.3.0.tar.xz https://gmplib.org/download/gmp/gmp-6.3.0.tar.xz https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz"
ARG MPFR_MIRRORS="https://mirrors.kernel.org/gnu/mpfr/mpfr-4.2.1.tar.xz https://www.mpfr.org/mpfr-4.2.1/mpfr-4.2.1.tar.xz https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.1.tar.xz"
# Must match the architecture of the emsdk image (picked by build.sh).
ARG CMAKE_TARBALL=https://github.com/Kitware/CMake/releases/download/v4.4.2/cmake-4.4.2-linux-aarch64.tar.gz

RUN clone cairo \
        https://gitlab.freedesktop.org/cairo/cairo.git "$CAIRO_REF" recursive
RUN clone libffi \
        https://github.com/libffi/libffi.git "$LIBFFI_REF"
RUN clone cgal \
        https://github.com/CGAL/cgal.git "$CGAL_REF"
RUN clone eigen \
        https://gitlab.com/libeigen/eigen.git "$EIGEN_REF"
RUN clone fontconfig \
        https://gitlab.freedesktop.org/fontconfig/fontconfig.git "$FONTCONFIG_REF"
RUN clone freetype \
        https://github.com/freetype/freetype.git "$FREETYPE_REF"
RUN clone glib \
        https://github.com/kleisauke/glib.git "$GLIB_REF" recursive
RUN clone harfbuzz \
        https://github.com/harfbuzz/harfbuzz.git "$HARFBUZZ_REF"
RUN clone libexpat \
        https://github.com/libexpat/libexpat "$LIBEXPAT_REF"
RUN clone libzip \
        https://github.com/nih-at/libzip.git "$LIBZIP_REF"
RUN clone zlib \
        https://github.com/madler/zlib.git "$ZLIB_REF"
RUN clone libxml2 \
        https://gitlab.gnome.org/GNOME/libxml2.git "$LIBXML2_REF"
RUN clone doubleconversion \
        https://github.com/google/double-conversion "$DOUBLECONVERSION_REF"

# lib3mf needs the in-tree patch from patches/.
COPY patches/lib3mf.patch /home/patches/lib3mf.patch
RUN clone lib3mf \
        https://github.com/3MFConsortium/lib3mf.git "$LIB3MF_REF" recursive && \
    git -C lib3mf apply /home/patches/lib3mf.patch

RUN clone openscad \
        https://github.com/openscad/openscad.git "$OPENSCAD_REF" recursive

# Sources for the runtime JS bundle (hex-embedded by rollup).
COPY res/fonts/fonts.conf /home/libs/res/fonts/fonts.conf
RUN clone res/liberation \
        https://github.com/shantigilbert/liberation-fonts-ttf.git "$LIBERATION_REF" recursive
RUN clone res/MCAD \
        https://github.com/openscad/MCAD.git "$MCAD_REF"

# Boost, GMP and MPFR come as release tarballs; boost needs its emscripten
# jamfile patched to use -fexceptions instead of -fwasm-exceptions.
RUN fetch boost.tar.xz "$BOOST_URL" && \
    tar xf boost.tar.xz && \
    mv boost-1.87.0 boost && \
    rm boost.tar.xz && \
    sed -i -E 's/-fwasm-exceptions/-fexceptions/g' \
        boost/tools/build/src/tools/emscripten.jam

RUN fetch gmp.tar.xz $GMP_MIRRORS && \
    tar xf gmp.tar.xz && \
    mv gmp-6.3.0 gmp && \
    rm gmp.tar.xz

RUN fetch mpfr.tar.xz $MPFR_MIRRORS && \
    tar xf mpfr.tar.xz && \
    mv mpfr-4.2.1 mpfr && \
    rm mpfr.tar.xz

RUN fetch cmake.tar.gz "$CMAKE_TARBALL"

COPY emscripten-crossfile.meson /home/libs/emscripten-crossfile.meson

###############################################################################
# Stage: builder
#
# Toolchain base for the dependency stages (mirrors "builder" from
# Dockerfile.base).
###############################################################################
FROM ${EMSCRIPTEN_SDK_TAG} AS builder

ARG CMAKE_BUILD_TYPE=Release
ARG MESON_BUILD_TYPE=release
ARG EMSCRIPTEN_FLAGS="-fexceptions -O3"
ARG JOBS

RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        automake \
        autopoint \
        bison \
        build-essential \
        ninja-build \
        ccache \
        flex \
        gettext \
        git \
        gperf \
        gpg \
        gpg-agent \
        libtool \
        pkg-config \
        prelink \
        python-is-python3 \
        python3 \
        python3-pip \
        texinfo \
        unzip \
        wget \
        libltdl-dev \
        libatk1.0-0 \
        libxkbcommon0 \
        libpango-1.0-0 \
        libatk-bridge2.0-0 \
        libxcomposite1 \
        libxdamage1 \
        libxfixes3 \
        libxrandr2 \
        libcairo2 \
        libdrm2 \
        libgbm1

RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install --break-system-packages \
        meson \
        packaging

RUN apt remove -y cmake
COPY --from=libs /home/libs/cmake.tar.gz /tmp/cmake.tar.gz
RUN tar -xz --strip-components=1 -f /tmp/cmake.tar.gz -C /usr/local && \
    rm /tmp/cmake.tar.gz

ENV CMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
ENV MESON_BUILD_TYPE=${MESON_BUILD_TYPE}
# Caps ninja parallelism in every stage that uses `cmake --build --parallel`
# (see ARG JOBS at the top of the file).
ENV CMAKE_BUILD_PARALLEL_LEVEL=${JOBS}
ENV CFLAGS="${EMSCRIPTEN_FLAGS}"
ENV CXXFLAGS="${EMSCRIPTEN_FLAGS}"
ENV LDFLAGS="${EMSCRIPTEN_FLAGS}"

# Build autoconf from source since we require 2.72
WORKDIR /home/ubuntu
COPY --from=libs /usr/local/bin/fetch /usr/local/bin/fetch
RUN fetch autoconf-2.72.tar.xz \
        https://mirrors.kernel.org/gnu/autoconf/autoconf-2.72.tar.xz \
        https://ftp.gnu.org/gnu/autoconf/autoconf-2.72.tar.xz && \
    tar -xf autoconf-2.72.tar.xz && \
    cd autoconf-2.72 && \
    ./configure && \
    make -j"${JOBS}" && \
    make install && \
    cd .. && \
    rm -rf autoconf-2.72 autoconf-2.72.tar.xz

WORKDIR /home/src

###############################################################################
# Dependency stages (mirror Dockerfile.base; sources come from the libs stage
# instead of the local libs/ directory).
###############################################################################

FROM builder AS boost
ARG JOBS
COPY --from=libs /home/libs/boost .
RUN ./bootstrap.sh && \
    ./b2 -j"${JOBS}" \
      --disable-icu \
      --prefix=/emsdk/upstream/emscripten/cache/sysroot \
      --with-filesystem \
      --with-program_options \
      --with-regex \
      --with-system \
      address-model=32 \
      cxxflags="-std=c++17 -stdlib=libc++ -fexceptions" \
      install \
      link=static \
      linkflags="-stdlib=libc++ -fexceptions" \
      release \
      runtime-link=static \
      toolset=emscripten


# NOTE: Dockerfile.base also carries "libexpat" and "cairo" stages, but they
# are NOT part of the final image: wasm-base does not copy their sysroot (the
# corresponding COPY lines there are commented out). Cairo is only needed for
# GUI rendering, which the headless NULLGL build does not use, and its pixman
# subproject does not link under emsdk 6.0.5 anyway. Both stages are therefore
# dropped here.


FROM builder AS zlib
COPY --from=libs /home/libs/zlib .
RUN emcmake cmake \
        -DINSTALL_PKGCONFIG_DIR="/emsdk/upstream/emscripten/cache/sysroot/lib/pkgconfig/" \
        -B ../build \
        -D ZLIB_BUILD_SHARED=OFF \
        -D ZLIB_BUILD_STATIC=ON \
        -D ZLIB_BUILD_TESTING=OFF \
        && \
    cmake --build ../build && \
    cmake --install ../build


FROM builder AS libzip
COPY --from=zlib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/libzip .
RUN emcmake cmake \
        -B ../build \
        -G Ninja \
        -DBUILD_OSSFUZZ=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TOOLS=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        && \
    cmake --build ../build --parallel && \
    cmake --install ../build


FROM builder AS libffi
ARG JOBS
COPY --from=libs /home/libs/libffi .
RUN ./autogen.sh && \
    emconfigure ./configure \
      --host wasm32-unknown-linux \
      --prefix=/emsdk/upstream/emscripten/cache/sysroot \
      --enable-static \
      --disable-shared \
      --disable-dependency-tracking \
      --disable-builddir \
      --disable-multi-os-directory \
      --disable-raw-api \
      --disable-docs \
      && \
    emmake make -j"${JOBS}" && \
    emmake make install SUBDIRS='include'


FROM builder AS glib
ARG JOBS
COPY --from=zlib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libffi /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/glib .
COPY --from=libs /home/libs/emscripten-crossfile.meson .
RUN meson \
      setup \
      ../build \
      --prefix=/emsdk/upstream/emscripten/cache/sysroot \
      --cross-file=emscripten-crossfile.meson \
      --default-library=static \
      --buildtype=${MESON_BUILD_TYPE} \
      --force-fallback-for=pcre2,gvdb \
      -Dselinux=disabled \
      -Dxattr=false \
      -Dlibmount=disabled \
      -Dnls=disabled \
      -Dtests=false \
      -Dglib_assert=false \
      -Dglib_checks=false \
      && \
    meson compile -C ../build -j "${JOBS}" && \
    meson install -C ../build


FROM builder AS freetype
COPY --from=zlib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/freetype .
RUN emcmake cmake \
        -B ../build \
        -DFT_REQUIRE_ZLIB=TRUE \
        -DDISABLE_FORCE_DEBUG_POSTFIX=TRUE \
        && \
    cmake --build ../build && \
    cmake --install ../build


FROM builder AS libxml2
COPY --from=libs /home/libs/libxml2 .
RUN emcmake cmake \
        -B ../build \
        -G Ninja \
        -DBUILD_SHARED_LIBS=OFF \
        -DLIBXML2_WITH_PYTHON=OFF \
        -DLIBXML2_WITH_LZMA=OFF \
        -DLIBXML2_WITH_ZLIB=OFF \
        -DLIBXML2_WITH_TESTS=OFF \
        -DLIBXML2_WITH_PROGRAMS=OFF \
        && \
    cmake --build ../build --parallel && \
    cmake --install ../build


FROM builder AS fontconfig
ARG JOBS
COPY --from=zlib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=freetype /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libxml2 /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/fontconfig .
ENV FREETYPE_CFLAGS="-I/emsdk/upstream/emscripten/cache/sysroot/include/freetype2"
ENV FREETYPE_LIBS="-lfreetype -lz"
RUN emconfigure ./autogen.sh \
        --host none \
        --disable-docs \
        --disable-shared \
        --enable-static \
        --disable-cache-build \
        --sysconfdir=/ \
        --localstatedir=/ \
        --with-default-fonts=/fonts \
        --enable-libxml2 \
        --prefix=/emsdk/upstream/emscripten/cache/sysroot \
        && \
    emmake make -j"${JOBS}" && \
    emmake make install


FROM builder AS harfbuzz
COPY --from=freetype /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/harfbuzz .
RUN emcmake cmake \
        -B ../build \
        -G Ninja \
        -DHB_HAVE_FREETYPE=ON \
        && \
    cmake --build ../build --parallel && \
    cmake --install ../build


FROM builder AS eigen
COPY --from=libs /home/libs/eigen .
RUN emcmake cmake \
        -B ../build \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/emsdk/upstream/emscripten/cache/sysroot \
        && \
    cmake --build ../build --parallel && \
    cmake --install ../build && \
    ln -s /emsdk/upstream/emscripten/cache/sysroot/include/eigen3/Eigen /emsdk/upstream/emscripten/cache/sysroot/include/Eigen


FROM builder AS cgal
COPY --from=libs /home/libs/cgal .
RUN emcmake cmake \
        -B ../build \
        -G Ninja && \
    cmake --build ../build --parallel \
        && \
    cmake --install ../build


FROM builder AS gmp
ARG JOBS
COPY --from=libs /home/libs/gmp .
RUN emconfigure ./configure \
        --disable-assembly \
        --host none \
        --enable-cxx --prefix=/emsdk/upstream/emscripten/cache/sysroot \
        HOST_CC=gcc \
        && \
    make -j"${JOBS}" && \
    make install


FROM builder AS mpfr
ARG JOBS
COPY --from=gmp /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/mpfr .
RUN emconfigure ./configure \
        --host none \
        --with-gmp=/emsdk/upstream/emscripten/cache/sysroot \
        --prefix=/emsdk/upstream/emscripten/cache/sysroot \
        && \
    make -j"${JOBS}" && \
    make install


FROM builder AS doubleconversion
COPY --from=libs /home/libs/doubleconversion .
RUN emcmake cmake \
        -B ../build \
        -G Ninja \
        && \
    cmake --build ../build --parallel && \
    cmake --install ../build


FROM builder AS lib3mf
COPY --from=zlib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libzip /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libs /home/libs/lib3mf .
# lib3mf needs an explicit ldflags because it's silly :)
RUN LDFLAGS="${LDFLAGS} -L/emsdk/upstream/emscripten/cache/sysroot/lib" \
    emcmake cmake \
        -B ../build \
        -DLIB3MF_TESTS=OFF \
        -DUSE_INCLUDED_ZLIB=OFF \
        -DUSE_INCLUDED_LIBZIP=OFF \
        -DBUILD_SHARED_LIBS=OFF \
        -DSTRIP_BINARIES=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -G Ninja && \
    cmake --build ../build --parallel && \
    cmake --install ../build


###############################################################################
# Stage: wasm-base
#
# Aggregated emscripten sysroot with all OpenSCAD dependencies installed.
###############################################################################
FROM builder AS wasm-base
COPY --from=boost /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=gmp /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=mpfr /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=cgal /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=eigen /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=harfbuzz /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=fontconfig /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=glib /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libzip /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=libffi /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=doubleconversion /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
COPY --from=lib3mf /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
# COPY --from=freetype /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
# COPY --from=cairo /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot
# COPY --from=libexpat /emsdk/upstream/emscripten/cache/sysroot /emsdk/upstream/emscripten/cache/sysroot

###############################################################################
# Stage: openscad
#
# Cross-compile OpenSCAD itself (mirrors Dockerfile).
###############################################################################
FROM wasm-base AS openscad

ARG CMAKE_BUILD_TYPE=Release
ARG CMAKE_BUILD_PARALLEL_LEVEL=
ARG EMSCRIPTEN_FLAGS="-fexceptions -O3"

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y full-upgrade

ENV CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}"
ENV CMAKE_C_FLAGS="${EMSCRIPTEN_FLAGS}"
ENV CMAKE_CXX_FLAGS="${EMSCRIPTEN_FLAGS}"
ENV CMAKE_EXE_LINKER_FLAGS="${EMSCRIPTEN_FLAGS}"

COPY --from=libs /home/libs/openscad .
RUN emcmake cmake -B /home/build . \
        -DBoost_USE_STATIC_RUNTIME=ON \
        -DBoost_USE_STATIC_LIBS=ON \
        -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} \
        -DCMAKE_BUILD_PARALLEL_LEVEL=${CMAKE_BUILD_PARALLEL_LEVEL} \
        -DEXPERIMENTAL=ON \
        -DHEADLESS=ON \
        -DNULLGL=ON \
        -DSNAPSHOT=ON \
        -G Ninja && \
    cmake --build /home/build --parallel && \
    ls -la /home/build && \
    cp /home/build/openscad.js /home/build/openscad.wasm.js && \
    { test -f /home/build/openscad.wasm.map || touch /home/build/openscad.wasm.map; }

###############################################################################
# Stage: runtime
#
# Bundle the JS runtime with rollup (this is what the Makefile does with
# `cd runtime; npm run build`), then assemble the final dist set:
#
#   openscad.js        - ES6 module factory (hand-written wrapper)
#   openscad.fonts.js  - optional font bundle for text()
#   openscad.mcad.js   - optional MCAD library bundle
#   openscad.wasm.js   - emscripten glue (renamed from openscad.js)
#   openscad.wasm      - the WASM binary
###############################################################################
FROM node:22-slim AS runtime

WORKDIR /home/repo
COPY --from=libs /home/libs/res res
COPY runtime/ runtime/

RUN cd runtime && \
    npm install --no-audit --no-fund && \
    npm run build

COPY --from=openscad /home/build/openscad.wasm.js /home/artifacts/openscad.wasm.js
COPY --from=openscad /home/build/openscad.wasm /home/artifacts/openscad.wasm
COPY --from=openscad /home/build/openscad.wasm.map /home/artifacts/openscad.wasm.map

RUN mkdir /out && \
    cp runtime/dist/*.js /out/ && \
    cp /home/artifacts/openscad.wasm.js /out/ && \
    cp /home/artifacts/openscad.wasm /out/ && \
    if [ -s /home/artifacts/openscad.wasm.map ]; then \
        cp /home/artifacts/openscad.wasm.map /out/; \
    fi && \
    ls -la /out

###############################################################################
# Stage: www-vendor
#
# Vendor three.js (module build + STL loader + orbit controls) so the example
# page works without any CDN access.
###############################################################################
FROM node:22-slim AS www-vendor

WORKDIR /vendor
ARG THREE_VERSION=0.170.0
RUN npm init -y >/dev/null && \
    npm install --no-audit --no-fund --no-save "three@${THREE_VERSION}" && \
    mkdir -p out/vendor && \
    cp node_modules/three/build/three.module.js node_modules/three/build/three.core.js out/vendor/ 2>/dev/null || \
        cp node_modules/three/build/three.module.js out/vendor/ && \
    cp node_modules/three/examples/jsm/loaders/STLLoader.js out/vendor/ && \
    cp node_modules/three/examples/jsm/controls/OrbitControls.js out/vendor/ && \
    cp node_modules/three/LICENSE out/vendor/LICENSE.three

###############################################################################
# Stage: example
#
# Ready-to-run nginx image serving the dist artifacts together with the
# example viewer page:   docker run --rm -p 8080:80 openscad-wasm:local
###############################################################################
FROM nginx:alpine AS example

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=runtime /out /usr/share/nginx/html
COPY --from=www-vendor /vendor/out/vendor /usr/share/nginx/html/vendor
COPY example/www/viewer.html /usr/share/nginx/html/index.html
COPY example/www/heightmap.html /usr/share/nginx/html/heightmap.html
COPY example/www/lib /usr/share/nginx/html/lib
# Height-map image for the surface() example (generated by gen-smiley.mjs)
COPY example/www/assets /usr/share/nginx/html/assets
